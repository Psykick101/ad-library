{
 "manifest_version": 3,
 "name": "Save to Psykick Studio",
 "version": "1.2.0",
 "description": "Save ads you find anywhere (TikTok, Instagram, Facebook, Meta Ad Library, YouTube, BigSpy, PiPiAds, any site) to the Psykick Creative Studio library - videos come with their source (author, caption, stats, link).",
 "permissions": [
  "activeTab",
  "alarms",
  "contextMenus",
  "notifications",
  "scripting",
  "storage"
 ],
 "host_permissions": [
  "https://studio.psykick.cc/*",
  "<all_urls>"
 ],
 "background": {
  "service_worker": "background.js"
 },
 "action": {
  "default_title": "Save to Psykick Studio",
  "default_popup": "popup.html",
  "default_icon": {
   "128": "icon128.png"
  }
 },
 "icons": {
  "128": "icon128.png"
 },
 "commands": {
  "save-area": {
   "suggested_key": {
    "default": "Alt+Shift+S"
   },
   "description": "Select an area and save it"
  }
 },
 "content_scripts": [
  {
   "matches": [
    "<all_urls>"
   ],
   "js": [
    "lastclick.js"
   ],
   "run_at": "document_start",
   "all_frames": false
  }
 ]
}