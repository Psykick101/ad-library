{
 "manifest_version": 3,
 "name": "Save to Psykick Studio",
 "version": "1.4.1",
 "description": "Save ads you find anywhere to the Psykick Creative Studio library. Videos are found by their post link and downloaded for real, with their source (author, caption, stats).",
 "permissions": [
  "activeTab",
  "alarms",
  "contextMenus",
  "cookies",
  "notifications",
  "scripting",
  "storage"
 ],
 "host_permissions": [
  "https://studio.psykick.cc/*",
  "<all_urls>"
 ],
 "background": {
  "service_worker": "background.js"
 },
 "action": {
  "default_title": "Save to Psykick Studio",
  "default_popup": "popup.html",
  "default_icon": {
   "128": "icon128.png"
  }
 },
 "icons": {
  "128": "icon128.png"
 },
 "commands": {
  "save-area": {
   "suggested_key": {
    "default": "Alt+Shift+S"
   },
   "description": "Select an area (or click a video) and save it"
  }
 },
 "externally_connectable": {
  "matches": [
   "https://studio.psykick.cc/*"
  ]
 },
 "content_scripts": [
  {
   "matches": [
    "<all_urls>"
   ],
   "js": [
    "lastclick.js"
   ],
   "run_at": "document_start",
   "all_frames": false
  },
  {
   "matches": [
    "https://studio.psykick.cc/studio/extension/connect*"
   ],
   "js": [
    "connect.js"
   ],
   "run_at": "document_start"
  }
 ]
}
